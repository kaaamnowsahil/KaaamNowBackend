# Copy to .env.dev / .env.test / .env.preprod / .env.prod (all gitignored).
# Select with ENV_PROFILE or `scripts/run.py --env <profile>`.

# --- Process ---
PORT=8000
LISTEN_HOST=0.0.0.0
LOG_LEVEL=info
LOG_TO_FILE=false
CORS_ORIGIN=*
BACKGROUND_JOBS_ENABLED=true
BACKGROUND_SWEEP_INTERVAL_SECONDS=15

# --- Database (created automatically when DB_AUTO_CREATE=true) ---
DATABASE_URL=postgres://localhost:5432/kaaamnow_dev
DB_AUTO_CREATE=true

# --- Auth --- (production: >= 32 random characters)
JWT_SECRET_KEY=change-me-to-a-long-random-string-of-32-plus-chars
JWT_ACCESS_MINUTES=15
JWT_REFRESH_DAYS=30

# --- OTP --- console = code printed to the API log (refused in prod)
#             firebase = client signs in with Firebase phone auth, posts the ID token
OTP_PROVIDER=console
FIREBASE_PROJECT_ID=kaaamnow-40336

# --- Marketplace policy (OWNER DECISIONS; defaults follow the Figma copy) ---
REQUIRE_VERIFIED_WORKERS=true
LIVE_INITIAL_RADIUS_KM=3
LIVE_MAX_RADIUS_KM=5
LIVE_RADIUS_EXPAND_AFTER_SECONDS=600
LIVE_SEARCH_TIMEOUT_SECONDS=1800
SCHEDULED_NOTIFY_RADIUS_KM=5
SELECTION_CONFIRM_HOURS=12
CHECK_IN_RADIUS_M=200

# --- Payments / payouts --- fake = dev simulators (refused in prod)
PAYMENT_PROVIDER=fake
PAYMENT_WEBHOOK_SECRET=
UPI_PAYEE_VPA=kaaamnow@upi
UPI_PAYEE_NAME=KaaamNow
PAYOUT_PROVIDER=fake
MIN_WITHDRAWAL_MINOR=10000

# --- Notifications / media ---
PUSH_PROVIDER=console
MEDIA_DIR=
MEDIA_BASE_URL=/media
SUPPORT_EMAIL=sumit.pandey@kaaamnow.in,sahil.shrivastava@kaaamnow.in
